# 🌸 kotonoha Configuration File

# Default maximum cards to mine per session
default_card_limit = 25

# Maximum recent cards to keep audio & screenshots for before auto-cleanup on startup
# (e.g. 50 cards = keeps up to 50 .opus audios + 50 .jpg screenshots). Set to 0 to disable cleanup.
max_cached_cards = 50

# Media storage directory for audio snippets & screenshots
media_dir = "~/.local/share/kotonoha/media"

# SQLite database file path
db_path = "~/.config/kotonoha/kotonoha.db"

# Audio padding around sentence timestamps (seconds)
audio_padding_secs = 0.25

# AnkiConnect Integration
enable_anki_sync = true
anki_connect_url = "http://127.0.0.1:8765"
anki_deck_name = "Anime Mining T1"

# Dictionary Definition Limits
max_definition_senses = 3
max_glosses_per_sense = 4

# Gemini AI Disambiguation
enable_ai = true
# gemini_api_key = "your_api_key_here"  # Or set GEMINI_API_KEY environment variable
gemini_model = "gemini-3.5-flash-lite"

